# Copiar a .env en la raíz. No commitear .env.

DATABASE_URL="file:./prisma/dev.db"

# Sesión de gerente (obligatorio; sin AUTH_SECRET la app no arranca)
GERENTE_USER=
GERENTE_PASSWORD=
AUTH_SECRET=

# Config pública del SDK web de Firebase (respaldo y panel remoto)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Ruta al JSON de la cuenta de servicio (fuera de git)
FIREBASE_SERVICE_ACCOUNT_PATH=
